# ------------------------------------------------------------
# f) Generación de texto de 1000 caracteres según p1, p2 y p3
# ------------------------------------------------------------

# Elegir un símbolo de acuerdo con las frecuencias observadas
def elegir_simbolo(conteos):
    simbolos = list(conteos.keys())
    cantidades = np.array(list(conteos.values()), dtype=float)
    probabilidades = cantidades / cantidades.sum()
    return rng.choice(simbolos, p=probabilidades)


def transiciones_orden2(pares):
    """Para cada carácter x1, cuenta qué caracteres x2 lo siguen."""
    transiciones = {}
    for (x1, x2), cantidad in pares.items():
        if x1 not in transiciones:
            transiciones[x1] = Counter()
        transiciones[x1][x2] += cantidad
    return transiciones


# Modelo p1: cada carácter se genera independientemente
def generar_p1(texto, longitud=1000):
    conteos = Counter(texto)
    muestra = [elegir_simbolo(conteos) for _ in range(longitud)]
    return "".join(muestra)


# Modelo p2: el siguiente carácter depende del anterior
def generar_p2(texto, longitud=1000):
    conteos1 = Counter(texto)
    pares = Counter(zip(texto[:-1], texto[1:]))
    transiciones = transiciones_orden2(pares)

    # Primer carácter elegido según p1
    muestra = [elegir_simbolo(conteos1)]

    while len(muestra) < longitud:
        anterior = muestra[-1]
        if anterior in transiciones:
            siguiente = elegir_simbolo(transiciones[anterior])
        else:
            siguiente = elegir_simbolo(conteos1)
        muestra.append(siguiente)

    return "".join(muestra)


# Modelo p3: el siguiente carácter depende de los dos anteriores
def generar_p3(texto, longitud=1000):
    conteos1 = Counter(texto)
    pares = Counter(zip(texto[:-1], texto[1:]))
    tripletas = Counter(zip(texto[:-2], texto[1:-1], texto[2:]))

    # Transiciones asociadas a cada par de contexto
    transiciones = {}
    for (x1, x2, x3), cantidad in tripletas.items():
        contexto = (x1, x2)
        if contexto not in transiciones:
            transiciones[contexto] = Counter()
        transiciones[contexto][x3] += cantidad

    # Para el caso de respaldo (se calcula una sola vez)
    transiciones2 = transiciones_orden2(pares)

    # Par inicial elegido según su frecuencia observada
    pares_lista = list(pares.keys())
    cantidades = np.array(list(pares.values()), dtype=float)
    probabilidades = cantidades / cantidades.sum()
    indice = rng.choice(len(pares_lista), p=probabilidades)
    par_inicial = pares_lista[indice]

    muestra = [par_inicial[0], par_inicial[1]]

    while len(muestra) < longitud:
        contexto = (muestra[-2], muestra[-1])

        if contexto in transiciones:
            siguiente = elegir_simbolo(transiciones[contexto])
        else:
            # Sin transición de tercer orden observada:
            # recurrimos a las de segundo orden
            ultimo = muestra[-1]
            if ultimo in transiciones2:
                siguiente = elegir_simbolo(transiciones2[ultimo])
            else:
                siguiente = elegir_simbolo(conteos1)

        muestra.append(siguiente)

    return "".join(muestra[:longitud])


# Generar las muestras de cada versión de Moby Dick
muestras = {}

for nombre, texto in textos.items():
    nombre_base = nombre.rsplit(".", 1)[0]
    muestras[f"{nombre_base}_p1.txt"] = generar_p1(texto)
    muestras[f"{nombre_base}_p2.txt"] = generar_p2(texto)
    muestras[f"{nombre_base}_p3.txt"] = generar_p3(texto)

# Mostrar las muestras y guardarlas en archivos .txt
for nombre, muestra in muestras.items():
    print(f"\nArchivo: {nombre}")
    print(f"Longitud: {len(muestra)} caracteres")
    print(muestra[:150])

    with open(nombre, "w", encoding="utf-8") as f:
        f.write(muestra)

print("\nSe generaron y guardaron las seis muestras.")


# ------------------------------------------------------------
# g) Estimación de la entropía de Moby Dick (compresión ZIP)
# ------------------------------------------------------------
print("Comparación de tamaños y estimación de entropía\n")

for nombre, contenido in archivos.items():
    texto_crudo = contenido.decode("utf-8")
    N = len(texto_crudo)
    tam_original = len(contenido)

    # Comprimir en formato ZIP, en memoria
    buffer = io.BytesIO()
    with zipfile.ZipFile(buffer, "w", compression=zipfile.ZIP_DEFLATED) as archivo_zip:
        archivo_zip.writestr(nombre, contenido)
        # Tamaño de los datos comprimidos, sin cabeceras
        tam_comprimido = archivo_zip.getinfo(nombre).compress_size

    # Tamaño total del ZIP, incluyendo metadatos
    tam_zip = len(buffer.getvalue())

    bits_por_caracter = 8 * tam_comprimido / N
    reduccion = 100 * (1 - tam_comprimido / tam_original)

    print(f"Archivo: {nombre}")
    print(f"Número de caracteres: {N}")
    print(f"Tamaño original: {tam_original} bytes")
    print(f"Tamaño comprimido: {tam_comprimido} bytes")
    print(f"Tamaño total del ZIP: {tam_zip} bytes")
    print(f"Reducción del tamaño: {reduccion:.2f} %")
    print(f"Estimación: {bits_por_caracter:.4f} bits/caracter")
    print("-" * 45)
