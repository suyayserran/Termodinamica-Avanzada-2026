import io
import zipfile
import numpy as np
import pandas as pd
from collections import Counter
from google.colab import files
from IPython.display import display

rng = np.random.default_rng()

# 26 letras (sin ñ) + espacio
ALFABETO = " abcdefghijklmnopqrstuvwxyz"
M = len(ALFABETO)

# Subir los archivos .txt de Moby Dick
archivos = files.upload()


def normalizar_texto(contenido):
    """Pasa a minúsculas, reemplaza ñ por n, convierte saltos de línea
    y tabulaciones en espacios y deja solo a-z y espacio."""
    texto = contenido.decode("utf-8").lower()
    texto = texto.replace("ñ", "n")
    texto = texto.replace("\n", " ").replace("\r", " ").replace("\t", " ")
    texto = "".join(c for c in texto if c == " " or "a" <= c <= "z")
    return texto.strip()


def entropia_1(texto):
    """s1 = -sum p(x) log2 p(x)"""
    N = len(texto)
    s1 = 0.0
    for cantidad in Counter(texto).values():
        p = cantidad / N
        s1 -= p * np.log2(p)
    return s1


def entropia_2(texto):
    """s2 = -sum p2(x1,x2) log2 p2(x2|x1)"""
    N = len(texto)
    pares = Counter(zip(texto[:-1], texto[1:]))

    # N(x1): apariciones de x1 como primer elemento de un par
    conteo_inicial = Counter()
    for (x1, x2), cantidad in pares.items():
        conteo_inicial[x1] += cantidad

    s2 = 0.0
    for (x1, x2), cantidad in pares.items():
        p_conjunta = cantidad / (N - 1)
        p_condicional = cantidad / conteo_inicial[x1]
        s2 -= p_conjunta * np.log2(p_condicional)
    return s2


def entropia_3(texto):
    """s3 = -sum p3(x1,x2,x3) log2 p3(x3|x1,x2)"""
    N = len(texto)
    tripletas = Counter(zip(texto[:-2], texto[1:-1], texto[2:]))

    # N(x1,x2): apariciones del par como contexto
    conteo_prefijos = Counter()
    for (x1, x2, x3), cantidad in tripletas.items():
        conteo_prefijos[(x1, x2)] += cantidad

    s3 = 0.0
    for (x1, x2, x3), cantidad in tripletas.items():
        p_conjunta = cantidad / (N - 2)
        p_condicional = cantidad / conteo_prefijos[(x1, x2)]
        s3 -= p_conjunta * np.log2(p_condicional)
    return s3


# Textos normalizados (uno por archivo subido)
textos = {}
for nombre, contenido in archivos.items():
    texto = normalizar_texto(contenido)
    if len(texto) < 3:
        raise ValueError(f"El archivo {nombre} no tiene suficientes caracteres válidos.")
    textos[nombre] = texto


